import ddf.minim.*;
import ddf.minim.ugens.*;
import processing.serial.*;

Minim minim;
AudioOutput out;
Waveform fluteWavetable;
Serial serialPort;

SerialManager serialManager;

// ←自分の環境のポート名に書き換える（下のリスト出力を参照）
String PORT_NAME = "/dev/cu.usbmodem34B7DA643AE82";

// ※ 倍音配列は Constants.pde に一本化（二重定義を解消）

void setup() {
  size(300, 200);
  minim = new Minim(this);
  out = minim.getLineOut(Minim.MONO, 512);

  // 1〜6次倍音の手動合成
  int tableSize = 1024;
  float[] waveBuffer = new float[tableSize];
  for (int i = 0; i < tableSize; i++) {
    float totalAmp = 0;
    float fraction = (float)i / tableSize;
    for (int h = 0; h < FLUTE_HARMONICS.length; h++) {
      int harmonicOrder = h + 1;
      float amplitude = FLUTE_HARMONICS[h];
      totalAmp += amplitude * sin(fraction * TWO_PI * harmonicOrder);
    }
    waveBuffer[i] = totalAmp;
  }
  fluteWavetable = new Wavetable(waveBuffer);

  serialManager = new SerialManager();

  println("利用可能なシリアルポート:");
  printArray(Serial.list());

  // シリアルポートを安全に開く（失敗してもクラッシュしない）
  try {
    serialPort = new Serial(this, PORT_NAME, 9600);
    serialPort.bufferUntil('\n');
    serialPort.clear();
    serialPort.write('S'); // Arduinoに演奏開始の合図
    println("シリアル接続成功: " + PORT_NAME);
  } catch (Exception e) {
    serialPort = null;
    println("シリアルポートを開けませんでした: " + PORT_NAME);
    println("上のリストから正しいポート名を選び、PORT_NAME を書き換えてください。");
  }
}

void draw() {
  background(40);
  fill(255);
  textAlign(CENTER, CENTER);
  if (serialPort != null) {
    text("Flute System: Playing...", width/2, height/2);
  } else {
    text("No Serial Port\n(see console)", width/2, height/2);
  }
}

void serialEvent(Serial port) {
  String s = port.readStringUntil('\n');
  if (s != null) {
    serialManager.processInput(trim(s));
  }
}

// Processing 3/4 では stop() ではなく dispose() を使う
void dispose() {
  if (out != null) out.close();
  if (minim != null) minim.stop();
  super.dispose();
}





